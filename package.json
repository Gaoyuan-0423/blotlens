{
  "name": "blotlens",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "tsx server/index.ts --production",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "evaluate": "tsx scripts/evaluate.ts",
    "check": "npm run test && npm run build",
    "package:release": "npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Local WB screenshot trend review with editable AI-assisted ROIs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gaoyuan-0423/blotlens.git"
  }
}
